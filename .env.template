# Nombre de la base de datos de WordPress
WORDPRESS_DB_NAME=

# Usuario y contraseña de la base de datos
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host de la base de datos (el servicio en docker-compose)
WORDPRESS_DB_HOST=db

# Nombre de la carpeta del tema personalizado
ACTIVE_THEME=build-theme

# Puerto en el que se expondrá WordPress (ej: http://localhost:8000)
WP_PORT=

# Puerto de NGINX para desarrollo si se usa proxy reverso (opcional)
NGINX_PORT=

# Puerto del servidor de desarrollo de Vite
VITE_PORT=

#Puerto de db
MYSQL_PORT=

# Entorno de WordPress
WP_ENV=development

# TBOH Hotel API Credentials
TBOH_API_URL=http://api.tbotechnology.in/TBOHolidays_HotelAPI
TBOH_API_USERNAME=
TBOH_API_PASSWORD=

# Hotelbeds API Credentials
HOTELBEDS_API_URL=https://api.test.hotelbeds.com
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
# Language for Hotelbeds transactional payloads (CAS=Castellano, ENG=English)
# If the requested language is not supported Hotelbeds falls back to ENG.
HB_LANGUAGE=CAS
# Source market ISO-2 country code (e.g., MX, ES). Blank = Hotelbeds default.
HB_SOURCE_MARKET=

# WordPress Debug Mode
WP_DEBUG=true

# Debug: Force price change detection (true/false)
# When true, modifies the original price to simulate a price change between Search and PreBook
TCM_DEBUG_FORCE_PRICE_CHANGE=false

# Debug: Force cancellation policy change detection (true/false)
# When true, simulates policy changes between Search and PreBook
TCM_DEBUG_FORCE_POLICY_CHANGE=false

# Debug: Simulate Cancel API errors (false/recovered/escalation)
# - false: Normal operation
# - recovered: Simulate timeout, then BookingDetail shows cancellation succeeded
# - escalation: Simulate timeout, then BookingDetail shows booking still active (requires manual escalation)
TCM_DEBUG_FORCE_CANCEL_ERROR=false

# Debug: Simulate provider search errors (none/random/tbo/hotelbeds)
# - none: Normal operation (default)
# - random: 50% chance any provider fails with timeout
# - tbo: TBO always fails (test Hotelbeds solo)
# - hotelbeds: Hotelbeds always fails (test TBO solo)
# Use this to test graceful degradation and partial results
TCM_SIMULATE_PROVIDER_ERRORS=none

# Hotel Provider Selection (comma-separated: tbo,hotelbeds)
# Controls which providers are active for /tcm/v1/hotels-search endpoint
# Multiple providers will return merged results
# Default: tbo
TCM_ACTIVE_PROVIDERS=tbo,hotelbeds

# Disable WordPress pseudo-cron in favor of system/external cron (true/false)
# When true, WordPress will NOT run wp-cron.php on every page load.
# Production MUST use a real cron job (e.g., system crontab calling wp-cron.php every minute).
# Required for reliable TBO certification follow-ups and other scheduled tasks.
# Default: false (pseudo-cron active — safe for local development)
TCM_DISABLE_WP_CRON=false

# Theme activation: create default pages and menus (true/false)
# When true, ThemeActivator creates predefined pages and nav menus on theme activation.
# When false or unset (default), pages and menus are NOT created — safe for re-activations
# and CI/CD environments where pre-existing content must not be overwritten.
# Accepted truthy values: true, 1, yes, on  — everything else resolves to false.
TCM_CREATE_DEFAULTS=false